{
  "name": "opencode-experthub",
  "version": "1.0.0",
  "description": "ExpertHub - OpenCode 动态专家加载插件系统，以专家包(pack)为单位动态管理 agent 和 skill",
  "type": "module",
  "main": "plugin.js",
  "bin": {
    "experthub": "cli.js"
  },
  "scripts": {
    "cli": "bun cli.js",
    "list": "bun cli.js list",
    "install:plugin": "bun cli.js install",
    "typecheck": "tsc --noEmit plugin.js cli.js lib/*.js 2>/dev/null || true"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "expert",
    "skill",
    "pack",
    "mcp"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.7"
  }
}
